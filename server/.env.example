# --- Required ---
MONGODB_URI=mongodb://localhost:27017/equity-iq
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Server config ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Google OAuth (optional; if unset, "Continue with Google" is hidden) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Market data providers ---
# Twelve Data is the recommended free source — works from cloud IPs that Yahoo
# blocks. 800 reqs/day, 8/min. Free signup: https://twelvedata.com/register
TWELVE_DATA_API_KEY=
# Finnhub: real-time quotes + news + company profile. Free signup: https://finnhub.io/register
FINNHUB_API_KEY=
# Alpha Vantage: fundamentals (P/E, EV/EBITDA), earnings. Free: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Massive: premium tier (snapshot, ratios, options, short interest)
MASSIVE_API_KEY=

# --- Pulse: social + insider + congressional + options flow (all optional) ---
# Quiver Quant: insider trades + congressional trades. Free at quiverquant.com/api
QUIVER_API_KEY=
# Polygon.io — primary data provider (consolidates 8+ providers into 1 paid source).
# Free tier:    history, profile, news, options OI/flow — works today with a free key.
# Starter $29:  financials, fundamentals, short interest, unlimited calls.
# Developer $79: real-time snapshot + WebSocket live prices.
# Options $29 add-on: full chain IV/greeks (replaces marketdata.app for implied moves).
# Get a key at https://polygon.io
POLYGON_API_KEY=

# --- Options-implied move (ATM IV / straddle) for the forecast trade logic ---
# Swappable adapter feeding implied_move_pct + the trade recommendation.
#   marketdata   — free token, international, reliable from cloud IPs, IV direct
#                  (~100 req/day). RECOMMENDED. Get a token at marketdata.app
#   alphavantage — reuses your ALPHA_VANTAGE_API_KEY but options is gated/limited
#                  on the free tier (often returns nothing); 25 req/day shared
#   tradier      — free sandbox token, reliable from cloud, but US-only signup
#   yahoo        — free, no key, but 429s from data-center IPs (e.g. Codespaces)
#   massive      — paid; implement massiveOptions.ts then set this
# The selector tries your choice first, then falls back across the free adapters.
OPTIONS_PROVIDER=marketdata
# marketdata.app token (recommended) — free signup at https://www.marketdata.app
MARKETDATA_TOKEN=
# Tradier (optional; sandbox signup is US-only): https://developer.tradier.com
TRADIER_TOKEN=
# TRADIER_BASE=https://sandbox.tradier.com/v1

# --- AI thesis (Anthropic Claude) ---
# Free $5 credit on signup at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Override the model if you want; default is claude-sonnet-4-5
ANTHROPIC_MODEL=
