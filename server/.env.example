# --- Required ---
MONGODB_URI=mongodb://localhost:27017/equity-iq
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Server config ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Google OAuth (optional; if unset, "Continue with Google" is hidden) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Market data providers ---
# Twelve Data is the recommended free source — works from cloud IPs that Yahoo
# blocks. 800 reqs/day, 8/min. Free signup: https://twelvedata.com/register
TWELVE_DATA_API_KEY=
# Finnhub: real-time quotes + news + company profile. Free signup: https://finnhub.io/register
FINNHUB_API_KEY=
# Alpha Vantage: fundamentals (P/E, EV/EBITDA), earnings. Free: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=
# Massive: premium tier (snapshot, ratios, options, short interest)
MASSIVE_API_KEY=
