# --- Required ---
MONGODB_URI=mongodb://localhost:27017/equity-iq
SESSION_SECRET=replace-me-with-a-long-random-string

# --- Server config ---
PORT=3001
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development

# --- Google OAuth (optional; if unset, "Continue with Google" is hidden) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# --- Market data providers (all optional; Yahoo works with no key) ---
MASSIVE_API_KEY=
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
